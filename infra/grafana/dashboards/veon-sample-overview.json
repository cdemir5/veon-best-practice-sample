            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Redis bağlı istemci & bellek",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (instance) (redis_connected_clients)",
          "legendFormat": "clients {{instance}}",
          "refId": "A",
          "range": true
