# `cp .env.example .env` ile kopyalayıp değerleri değiştirin. .env repoya EKLENMEZ.
# Kubernetes'te bu değerler Secret'tan gelir (bkz. deploy/helm/veon-sample-app/values.yaml).
APP_VERSION=0.1.0
REDIS_PASSWORD=change-me-redis
REDIS_SENTINEL_PASSWORD=change-me-sentinel

# Host portları (başka bir stack ile çakışıyorsa değiştirin)
FRONTEND_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
KIBANA_PORT=5601
MONGO_PORT=27017
ALLOY_PORT=12345
JAEGER_PORT=16686
